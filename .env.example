# BIOTROP V2 — ambiente de produção
NODE_ENV=production
PORT=3000
CORS_ORIGINS=https://SEU-DOMINIO
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=CHAVE_PUBLICA
SUPABASE_SERVICE_ROLE_KEY=SEGREDO_SOMENTE_NO_SERVIDOR

# Microsoft Graph — habilitar somente quando a conta remetente corporativa estiver aprovada
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
GRAPH_SENDER_EMAIL=manutencao@biotrop.com.br

# Microsoft Entra/Azure OAuth para a etapa de autenticação corporativa
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://SEU-DOMINIO/auth/v1/callback

# Upload local da VM (usar Storage externo para arquivos críticos quando aprovado)
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=104857600
